//prisma schema.prisma 
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider  = "prisma-client-py"
  interface = "asyncio"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  MEMBER
  ADMIN
  SUPER_ADMIN
}

// ============================================================
// MODELS
// ============================================================

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  picture          String?
  designation      String?   @map("designation")
  dateOfJoining    DateTime? @map("date_of_joining")
  birthdate        DateTime? @map("birthdate")
  googleSub        String?   @unique @map("google_sub")
  role             Role      @default(MEMBER)
  isBanned         Boolean   @default(false) @map("is_banned")
  bannedUntil      DateTime? @map("banned_until")
  banReason        String?   @map("ban_reason")
  hasLoggedInApp   Boolean   @default(false) @map("has_logged_in_app")
  hasLoggedInPanel Boolean   @default(false) @map("has_logged_in_panel")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  // Relations — not DB columns, Prisma navigation only 
  authoredPosts Post[]    @relation("PostAuthor")
  taggedInPosts PostTag[] @relation("TaggedInPosts")
  taggedInComments CommentTag[] @relation("TaggedInComments")
  likes         Like[]    @relation("UserLikes")
  comments      Comment[] @relation("CommentAuthor")
  sentAppreciations     Appreciation[]          @relation("SentAppreciations")
  receivedAppreciations AppreciationRecipient[] @relation("ReceivedAppreciations")
  reportedAlerts AdminAlert[] @relation("ReportedInAlerts")
  resolvedAlerts AdminAlert[] @relation("AlertsResolvedBy")

  @@index([deletedAt])
  @@index([isBanned])
  @@index([hasLoggedInApp])
  @@index([hasLoggedInPanel])
  @@index([role, deletedAt])
  @@index([isBanned, deletedAt])
  @@index([hasLoggedInApp, isBanned, deletedAt])
  @@index([hasLoggedInPanel, isBanned, deletedAt])
  @@map("users")
}

// ============================================================
// ENUMS
// ============================================================

enum PostType {
  USER_POST
  APPRECIATION
  SYSTEM_BIRTHDATE
  SYSTEM_ANNIVERSARY
  LINKEDIN_IMPORT
}

// Applies to both Post and Comment
enum ContentStatus {
  PENDING_SCAN  // just created, awaiting moderation check
  PUBLISHED     // passed moderation, visible in feed
  FLAGGED       // failed moderation, hidden from feed
  REMOVED       // hidden from feed — either user deleted their own post (flagReason = NORMAL) or system/admin removed it for policy violation (flagReason = NSFW_*)
}

// Reason a Post or Comment was flagged
enum FlagReason {
  NSFW_TEXT     // caption or comment body failed text moderation
  NSFW_IMAGE    // one or more images in the post failed image moderation
  UNSAFE_LINK   // caption contains a link that failed safety check
  NORMAL        // user deleted their own content — no policy violation
}

// ============================================================
// FEED MODELS
// ============================================================


model Post {
  id         String        @id @default(cuid())
  type       PostType      @default(USER_POST)
  authorId   String?       @map("author_id")
  caption    String?       // supports markdown
  status     ContentStatus @default(PENDING_SCAN)
  sourceUrl  String?       @map("source_url")  // populated for LINKEDIN_IMPORT only
  flagReason FlagReason?   @map("flag_reason") // null until moderation runs
  flaggedAt  DateTime?     @map("flagged_at")  // null unless status = FLAGGED or REMOVED
  deletedAt  DateTime?     @map("deleted_at")  // timestamp used by purge job for 30-day hard delete window
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  captionEditedAt DateTime? @map("caption_edited_at") // set only on author caption edit

  // Relations
  author   User?       @relation("PostAuthor", fields: [authorId], references: [id])
  media    PostMedia[]
  tags     PostTag[]
  likes    Like[]
  comments Comment[]
  alerts AdminAlert[]

  @@index([status, deletedAt, createdAt(sort: Desc)]) // primary feed query index
  @@index([authorId, status, deletedAt])              // "my posts" query
  @@index([type, deletedAt])                          // filter by post type
  @@map("posts")
}

model PostMedia {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  url       String                        // Supabase Storage URL
  order     Int                           // carousel position, 0-indexed
  altText   String?  @map("alt_text")    // accessibility text
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_media")
}

model PostTag {
  id           String   @id @default(cuid())
  postId       String   @map("post_id")
  taggedUserId String   @map("tagged_user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  post       Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  taggedUser User @relation("TaggedInPosts", fields: [taggedUserId], references: [id])

  @@unique([postId, taggedUserId]) // same user cannot be tagged twice on the same post
  @@index([taggedUserId])
  @@map("post_tags")
}

model Like {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("UserLikes", fields: [userId], references: [id])

  @@unique([postId, userId]) // one like per user per post, enforced at DB level
  @@index([postId])
  @@index([userId])
  @@map("likes")
}

model Comment {
  id         String        @id @default(cuid())
  postId     String        @map("post_id")
  authorId   String        @map("author_id")
  parentId   String?       @map("parent_id")   // null = top-level, set = reply (max depth 1)
  body       String
  status     ContentStatus @default(PENDING_SCAN)
  flagReason FlagReason?   @map("flag_reason") // null until moderation runs
  flaggedAt  DateTime?     @map("flagged_at")  // null unless status = FLAGGED or REMOVED
  deletedAt  DateTime?     @map("deleted_at")  // timestamp used by purge job for 30-day hard delete window
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User      @relation("CommentAuthor", fields: [authorId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")
  tags CommentTag[]

  @@index([postId, status, deletedAt]) // fetch comments for a post
  @@index([authorId, status])          // "my comments" query
  @@map("comments")
}

model CommentTag {
  id           String   @id @default(cuid())
  commentId    String   @map("comment_id")
  taggedUserId String   @map("tagged_user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  comment    Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  taggedUser User    @relation("TaggedInComments", fields: [taggedUserId], references: [id])

  @@unique([commentId, taggedUserId]) // same user cannot be tagged twice in the same comment
  @@index([taggedUserId])
  @@map("comment_tags")
}

// ============================================================
// APPRECIATION MODELS
// ============================================================

model AppreciationType {
  id           String   @id @default(cuid())
  name         String   @unique
  emojiPath    String   @map("emoji_path")
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0)    @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  appreciations Appreciation[]

  @@map("appreciation_types")
}

model Appreciation {
  id                 String    @id @default(cuid())
  senderId           String    @map("sender_id")
  appreciationTypeId String    @map("appreciation_type_id")
  message            String?
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt      @map("updated_at")

  sender           User                    @relation("SentAppreciations", fields: [senderId], references: [id])
  appreciationType AppreciationType        @relation(fields: [appreciationTypeId], references: [id])
  recipients       AppreciationRecipient[]

  @@index([senderId])
  @@index([deletedAt])
  @@map("appreciations")
}

model AppreciationRecipient {
  id             String    @id @default(cuid())
  appreciationId String    @map("appreciation_id")
  userId         String    @map("user_id")
  seenAt         DateTime? @map("seen_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  appreciation Appreciation @relation(fields: [appreciationId], references: [id])
  user         User         @relation("ReceivedAppreciations", fields: [userId], references: [id])

  @@unique([appreciationId, userId])
  @@index([userId])
  @@map("appreciation_recipients")
}

// ============================================================
// ENUMS
// ============================================================
enum AlertAction {
  RESTORED           // admin restored post to PUBLISHED
  CONFIRMED_REMOVAL  // admin confirmed post stays REMOVED
  AUTO_REMOVED       // system removed at high confidence, no admin action needed
}

// ============================================================
// ALERT MODELS
// ============================================================
model AdminAlert {
  id             String       @id @default(cuid())
  postId         String       @map("post_id")
  reportedUserId String       @map("reported_user_id")
  flagDetails    String?      @map("flag_details")   // JSON: raw API scores + categories
  resolvedAt     DateTime?    @map("resolved_at")
  resolvedById   String?      @map("resolved_by_id")
  resolvedAction AlertAction? @map("resolved_action") // null = pending admin review
  createdAt      DateTime     @default(now()) @map("created_at")

  post         Post  @relation(fields: [postId], references: [id])
  reportedUser User  @relation("ReportedInAlerts", fields: [reportedUserId], references: [id])
  resolvedBy   User? @relation("AlertsResolvedBy", fields: [resolvedById], references: [id])

  @@index([resolvedAction])
  @@index([reportedUserId])
  @@map("admin_alerts")
}