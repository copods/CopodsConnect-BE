datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider  = "prisma-client-py"
  interface = "asyncio"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  MEMBER
  ADMIN
  SUPER_ADMIN
}

// ============================================================
// MODELS
// ============================================================

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  picture          String?
  designation      String?   @map("designation")
  dateOfJoining    DateTime? @map("date_of_joining")
  birthdate        DateTime? @map("birthdate")
  googleSub        String?   @unique @map("google_sub")
  role             Role      @default(MEMBER)
  isBanned         Boolean   @default(false) @map("is_banned")
  bannedUntil      DateTime? @map("banned_until")
  banReason        String?   @map("ban_reason")
  hasLoggedInApp   Boolean   @default(false) @map("has_logged_in_app")
  hasLoggedInPanel Boolean   @default(false) @map("has_logged_in_panel")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  // Relations — not DB columns, Prisma navigation only
  authoredPosts         Post[]                  @relation("PostAuthor")
  taggedInPosts         PostTag[]               @relation("TaggedInPosts")
  taggedInComments      CommentTag[]            @relation("TaggedInComments")
  likes                 Like[]                  @relation("UserLikes")
  comments              Comment[]               @relation("CommentAuthor")
  sentAppreciations     Appreciation[]          @relation("SentAppreciations")
  receivedAppreciations AppreciationRecipient[] @relation("ReceivedAppreciations")
  reportedAlerts        AdminAlert[]            @relation("ReportedInAlerts")
  resolvedAlerts        AdminAlert[]            @relation("AlertsResolvedBy")
  blacklistEntries      ModerationBlacklist[]   @relation("BlacklistAddedBy")
  whitelistEntries      ModerationWhitelist[]   @relation("WhitelistAddedBy")
  pollsCreated          Poll[]                  @relation("PollCreator")  
  pollVotes             PollVote[]              @relation("PollVotes")

  // Every audit log row where this user was the actor (actorType USER or ADMIN)
  auditLogs     AuditLog[]         @relation("AuditActor")
  // This user's personal notification inbox — fan-out rows pointing back to audit_logs
  notifications UserNotification[] @relation("NotificationFeed")

  @@index([deletedAt])
  @@index([isBanned])
  @@index([hasLoggedInApp])
  @@index([hasLoggedInPanel])
  @@index([role, deletedAt])
  @@index([isBanned, deletedAt])
  @@index([hasLoggedInApp, isBanned, deletedAt])
  @@index([hasLoggedInPanel, isBanned, deletedAt])
  @@map("users")
}

// ============================================================
// ENUMS
// ============================================================

enum PostType {
  USER_POST
  APPRECIATION
  SYSTEM_BIRTHDATE
  SYSTEM_ANNIVERSARY
  LINKEDIN_IMPORT
  POLL
}

// Applies to both Post and Comment
enum ContentStatus {
  PENDING_SCAN // just created, awaiting moderation check
  PUBLISHED // passed moderation, visible in feed
  FLAGGED // failed moderation, hidden from feed
  REMOVED // hidden from feed — either user deleted their own post (flagReason = NORMAL) or system/admin removed it for policy violation (flagReason = NSFW_*)
}

// Reason a Post or Comment was flagged
enum FlagReason {
  NSFW_TEXT // caption or comment body failed text moderation
  NSFW_IMAGE // one or more images in the post failed image moderation
  UNSAFE_LINK // caption contains a link that failed safety check
  NORMAL // user deleted their own content — no policy violation
}

// ============================================================
// FEED MODELS
// ============================================================

model Post {
  id         String        @id @default(cuid())
  type       PostType      @default(USER_POST)
  authorId   String?       @map("author_id")
  caption    String?
  status     ContentStatus @default(PENDING_SCAN)
  sourceUrl  String?       @map("source_url")
  flagReason FlagReason?   @map("flag_reason")
  flaggedAt  DateTime?     @map("flagged_at")
  deletedAt  DateTime?     @map("deleted_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  captionEditedAt DateTime? @map("caption_edited_at") // set only on author caption edit

  author   User?        @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  media    PostMedia[]
  tags     PostTag[]
  likes    Like[]
  comments Comment[]
  alerts   AdminAlert[]
  appreciation Appreciation?
  poll         Poll? 

  @@index([status, deletedAt, createdAt(sort: Desc)])
  @@index([authorId, status, deletedAt])
  @@index([type, deletedAt])
  @@map("posts")
}

model PostMedia {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  url       String
  order     Int
  altText   String?  @map("alt_text")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_media")
}

model PostTag {
  id           String   @id @default(cuid())
  postId       String   @map("post_id")
  taggedUserId String   @map("tagged_user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  post       Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  taggedUser User @relation("TaggedInPosts", fields: [taggedUserId], references: [id], onDelete: Cascade)

  @@unique([postId, taggedUserId])
  @@index([taggedUserId])
  @@map("post_tags")
}

model Like {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  reactionType String? @map("reaction_type") 

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("UserLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("likes")
}

model Comment {
  id         String        @id @default(cuid())
  postId     String        @map("post_id")
  authorId   String        @map("author_id")
  parentId   String?       @map("parent_id")
  body       String
  status     ContentStatus @default(PENDING_SCAN)
  flagReason FlagReason?   @map("flag_reason")
  flaggedAt  DateTime?     @map("flagged_at")
  deletedAt  DateTime?     @map("deleted_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  post    Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User         @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?     @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[]    @relation("CommentReplies")
  tags    CommentTag[]
  alerts  AdminAlert[]

  @@index([postId, status, deletedAt])
  @@index([authorId, status])
  @@map("comments")
}

model CommentTag {
  id           String   @id @default(cuid())
  commentId    String   @map("comment_id")
  taggedUserId String   @map("tagged_user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  comment    Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  taggedUser User    @relation("TaggedInComments", fields: [taggedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, taggedUserId])
  @@index([taggedUserId])
  @@map("comment_tags")
}

// ============================================================
// APPRECIATION MODELS
// ============================================================

model AppreciationType {
  id           String   @id @default(cuid())
  name         String   @unique
  emojiPath    String   @map("emoji_path")
  badgePath    String?  @map("badge_path")
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  appreciations Appreciation[]

  @@map("appreciation_types")
}

model Appreciation {
  id                 String    @id @default(cuid())
  senderId           String    @map("sender_id")
  appreciationTypeId String    @map("appreciation_type_id")
  postId             String    @unique @map("post_id")
  message            String?
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  sender           User                    @relation("SentAppreciations", fields: [senderId], references: [id], onDelete: Cascade)
  appreciationType AppreciationType        @relation(fields: [appreciationTypeId], references: [id])
  post             Post                    @relation(fields: [postId], references: [id], onDelete: Cascade) 
  recipients       AppreciationRecipient[]

  @@index([senderId])
  @@index([deletedAt])
  @@map("appreciations")
}

model AppreciationRecipient {
  id             String    @id @default(cuid())
  appreciationId String    @map("appreciation_id")
  userId         String    @map("user_id")
  seenAt         DateTime? @map("seen_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  appreciation Appreciation @relation(fields: [appreciationId], references: [id], onDelete:Cascade)
  user         User         @relation("ReceivedAppreciations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appreciationId, userId])
  @@index([userId])
  @@map("appreciation_recipients")
}

// ============================================================
// ENUMS
// ============================================================
enum AlertAction {
  RESTORED
  CONFIRMED_REMOVAL
  AUTO_REMOVED
  BLACKLISTED
  WHITELISTED
}

// ============================================================
// ALERT MODELS
// ============================================================
model AdminAlert {
  id             String       @id @default(cuid())
  postId         String       @map("post_id")
  commentId      String?      @map("comment_id")
  reportedUserId String       @map("reported_user_id")
  flagDetails    String?      @map("flag_details")
  flaggedPhrase  String?      @map("flagged_phrase")
  resolvedAt     DateTime?    @map("resolved_at")
  resolvedById   String?      @map("resolved_by_id")
  resolvedAction AlertAction? @map("resolved_action")
  createdAt      DateTime     @default(now()) @map("created_at")

  post         Post     @relation(fields: [postId], references: [id])
  comment      Comment? @relation(fields: [commentId], references: [id])
  reportedUser User     @relation("ReportedInAlerts", fields: [reportedUserId], references: [id], onDelete: Cascade)
  resolvedBy   User?    @relation("AlertsResolvedBy", fields: [resolvedById], references: [id], onDelete: Cascade)

  @@index([resolvedAction])
  @@index([reportedUserId])
  @@map("admin_alerts")
}
// ============================================================
// MODERATION LISTS
// Admin-curated blacklist and whitelist for text moderation.
// normalizedKey = squish_normalize(rawPhrase), used for dedup
// only — runtime matching uses in-memory automatons.
// ============================================================

model ModerationBlacklist {
  id            String   @id @default(cuid())
  rawPhrase     String   @map("raw_phrase")
  normalizedKey String   @unique @map("normalized_key")
  addedById     String?   @map("added_by_id")
  alertId       String?  @map("alert_id")
  createdAt     DateTime @default(now()) @map("created_at")

  addedBy User? @relation("BlacklistAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([normalizedKey])
  @@map("moderation_blacklist")
}

model ModerationWhitelist {
  id            String   @id @default(cuid())
  rawPhrase     String   @map("raw_phrase")
  normalizedKey String   @unique @map("normalized_key")
  addedById     String?   @map("added_by_id")
  alertId       String?  @map("alert_id")
  createdAt     DateTime @default(now()) @map("created_at")

  addedBy User? @relation("WhitelistAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([normalizedKey])
  @@map("moderation_whitelist")
}

// ============================================================
// ENUMS — AUDIT
// ============================================================

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

enum AuditEntityType {
  USER
  POST
  COMMENT
  LIKE
  APPRECIATION
  APPRECIATION_TYPE
  ALERT
  INVITATION
  POLL
  POLL_VOTE     
}

enum AuditEventType {
  // ── User Lifecycle ─────────────────────────────────────────
  USER_INVITED
  USER_INVITATION_RESENT
  USER_LOGIN_APP
  USER_LOGIN_PANEL
  USER_LOGOUT_APP
  USER_LOGOUT_PANEL
  USER_PROFILE_UPDATED
  USER_AVATAR_UPDATED
  USER_SOFT_DELETED
  USER_RESTORED
  USER_PERMANENTLY_DELETED

  // ── Access Control ─────────────────────────────────────────
  USER_BANNED
  USER_BAN_UPDATED
  USER_UNBANNED_MANUAL
  USER_UNBANNED_AUTO
  USER_ROLE_CHANGED

  // ── Post Lifecycle ──────────────────────────────────────────
  POST_CREATED
  POST_SCAN_COMPLETED
  POST_CAPTION_EDITED
  POST_DELETED_BY_AUTHOR
  POST_REMOVED_BY_ADMIN
  POST_RESTORED_BY_ADMIN

  // ── Post Interactions ───────────────────────────────────────
  POST_LIKED
  POST_UNLIKED
  USER_TAGGED_IN_POST
  USER_UNTAGGED_FROM_POST

  // ── Comment Lifecycle ────────────────────────────────────────
  COMMENT_CREATED
  COMMENT_SCAN_COMPLETED
  COMMENT_EDITED
  COMMENT_DELETED_BY_AUTHOR
  COMMENT_REMOVED_BY_ADMIN
  COMMENT_RESTORED_BY_ADMIN

  // ── Comment Interactions ─────────────────────────────────────
  USER_TAGGED_IN_COMMENT

  // ── Appreciations ─────────────────────────────────────────────
  APPRECIATION_TYPE_CREATED
  APPRECIATION_TYPE_TOGGLED
  APPRECIATION_SENT

  // ── Moderation ───────────────────────────────────────────────
  ALERT_CREATED
  ALERT_RESOLVED

  // ── Analytics / Behavioural ─────────────────────────────────
  USER_SEARCH_PERFORMED

  // ── System Jobs — Per-Entity Events Only ─────────────────────
  USER_BAN_EXPIRED
  USER_PURGED_BY_JOB
  SYSTEM_BIRTHDAY_POST_CREATED
  SYSTEM_ANNIVERSARY_POST_CREATED
  
  // ── Polls ──────────────────────────────────────────────────
  POLL_CREATED
  POLL_VOTE_CAST
  POLL_OPTIONS_OR_CAPTION_EDITED
  POLL_CLOSED_MANUALLY
  POLL_REOPENED_MANUALLY
  POLL_EXTENDED
  POLL_DELETED_BY_AUTHOR   // reserved for future use, not currently fired — see note below
}

// ============================================================
// AUDIT LOG
// Immutable, append-only record of every event in the system.
// ============================================================

model AuditLog {
  id               String           @id @default(cuid())
  eventType        AuditEventType   @map("event_type")
  actorType        AuditActorType   @map("actor_type")
  actorId          String?          @map("actor_id")
  entityType       AuditEntityType  @map("entity_type")
  entityId         String           @map("entity_id")
  parentEntityType AuditEntityType? @map("parent_entity_type")
  parentEntityId   String?          @map("parent_entity_id")
  metadata         Json?
  createdAt        DateTime         @default(now()) @map("created_at")

  actor             User?              @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  // Required reverse side of UserNotification.auditLog — every fan-out row
  // generated from this event.
  userNotifications UserNotification[]

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([parentEntityType, parentEntityId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ============================================================
// USER NOTIFICATION
// Fan-out table — one row per (audit_log × recipient).
// ============================================================

model UserNotification {
  id          String    @id @default(cuid())
  auditLogId  String    @map("audit_log_id")
  recipientId String    @map("recipient_id")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  auditLog  AuditLog @relation(fields: [auditLogId], references: [id], onDelete: Cascade)
  recipient User     @relation("NotificationFeed", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([auditLogId, recipientId])
  @@index([recipientId, createdAt(sort: Desc)])
  @@index([recipientId, readAt])
  @@map("user_notifications")
}

// ============================================================
// POLL MODELS
// ============================================================

model Poll {
  id               String    @id @default(cuid())
  postId           String    @unique @map("post_id")
  creatorId        String    @map("creator_id")
  closesAt         DateTime? @map("closes_at")
  isManuallyClosed Boolean   @default(false) @map("is_manually_closed")
  manuallyClosedAt DateTime? @map("manually_closed_at")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  post    Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  creator User         @relation("PollCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@index([creatorId])
  @@index([deletedAt])
  @@map("polls")
}

model PollOption {
  id        String   @id @default(cuid())
  pollId    String   @map("poll_id")
  text      String
  order     Int      @default(0)
  voteCount Int      @default(0) @map("vote_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String   @map("poll_id")
  optionId  String   @map("option_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation("PollVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])
  @@map("poll_votes")
}